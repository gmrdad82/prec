#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."

mode=unit
case "${1-}" in
  "") ;;
  --render) mode=render ;;
  *)
    echo "usage: bin/gate [--render]" >&2
    exit 2
    ;;
esac

if [ "$mode" = render ]; then
  cargo test --locked --tests
  exit 0
fi

shellcheck bin/gate
cargo fmt --check
cargo clippy --locked --all-targets -- -D warnings
cargo test --locked --bins
