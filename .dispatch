name = "prec"

[gate]
fast = "export CARGO_NET_GIT_FETCH_WITH_CLI=true; shellcheck bin/gate bin/docs-bundle bin/marks && cargo fmt --check && cargo clippy --locked --all-targets -- -D warnings"
full = "dispatch test-track ."

[commands]
release = ""
deploy = ""

[[test_track.jobs]]
name = "unit"
command = "export CARGO_NET_GIT_FETCH_WITH_CLI=true; cargo fmt --check && cargo clippy --locked --all-targets -- -D warnings && cargo nextest run --locked --workspace --bins --no-tests=pass --partition count:${DISPATCH_SHARD:-1}/${DISPATCH_SHARDS:-1}"

[[test_track.jobs]]
name = "render"
command = "export CARGO_NET_GIT_FETCH_WITH_CLI=true; cargo nextest run --workspace --test '*' --no-tests=pass --partition count:${DISPATCH_SHARD:-1}/${DISPATCH_SHARDS:-1}"
needs = ["os:linux"]
alone = true
